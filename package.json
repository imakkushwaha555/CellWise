{
  "name": "word-table-formulas",
  "version": "0.1.0",
  "description": "Excel-style A1 formulas for Word tables, with no helper rows or columns.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --experimental-strip-types src/formula.test.ts",
    "typecheck": "npx tsc --noEmit",
    "certs": "npx office-addin-dev-certs install",
    "serve": "node scripts/serve.mjs",
    "validate": "npx office-addin-manifest validate manifest.xml"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/office-js": "^1.0.400",
    "esbuild": "^0.24.0",
    "office-addin-manifest": "^3.0.1",
    "typescript": "^5.6.0"
  }
}
