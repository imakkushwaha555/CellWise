{
  "name": "cellwise",
  "version": "1.0.0",
  "description": "Local A1 formulas for document tables, with no helper rows or columns.",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/cellwise.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/cellwise/issues"
  },
  "homepage": "https://github.com/OWNER/cellwise#readme",
  "keywords": [
    "word-addin",
    "office-js",
    "table-formulas",
    "spreadsheet",
    "a1-notation"
  ],
  "author": "Your Name (placeholder)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "test": "node --experimental-strip-types src/formula.test.ts && node --experimental-strip-types src/wordClient.test.ts",
    "typecheck": "npx tsc --noEmit",
    "certs": "npx office-addin-dev-certs install",
    "serve": "node scripts/serve.mjs",
    "validate": "npx office-addin-manifest validate manifest.xml"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/office-js": "^1.0.400",
    "esbuild": "^0.24.0",
    "office-addin-manifest": "^3.0.1",
    "typescript": "^5.6.0"
  }
}
